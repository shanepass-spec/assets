+// v1.18.0 — read-path tunables
+const TERMINAL_RETENTION_DAYS = 30; // terminal rows younger than this stay on /board
+const BOARD_HARD_CAP = 200;         // absolute max rows any board read returns
+const ARCHIVE_PAGE_DEFAULT = 25;    // default /archive page size
+const ARCHIVE_PAGE_MAX = 100;       // hard max /archive page size
+const TERMINAL_EXACT = ["done", "closed", "complete", "completed", "verified"];
+const BOARD_LEAN_COLS = ["id", "project", "status", "next_actor", "updated_at", "shane_needed_only_for"];
+
+// v1.18.0 — normalize a status: lowercase, trim, unify separators ('_' -> '-').
+function normStatus(status) {
+  return String(status == null ? "" : status).trim().toLowerCase().replace(/_/g, "-");
+}
+// Terminal = finished work: the exact set plus ANY "verified-*" spelling.
+function isTerminal(status) {
+  const s = normStatus(status);
+  if (TERMINAL_EXACT.indexOf(s) !== -1) return true;
+  if (s === "verified" || s.indexOf("verified-") === 0) return true;
+  return false;
+}
+function bucketFor(status) {
+  const s = normStatus(status);
+  if (s === "parked") return "parked";
+  if (s === "blocked") return "blocked";
+  if (isTerminal(s)) return "done";
+  if (s === "active" || s === "open" || s === "in-progress" || s === "in progress" || s === "") return "active";
+  return "other";
+}
+// "populated / actionable" — same intent as the worker's existing isRealGate();
+// you may reuse isRealGate(v) here instead of isPopulated.
+const _EMPTY_MARKERS = ["", "none", "none.", "-", "—", "n/a", "nothing", "nothing."];
+function isPopulated(v) { return _EMPTY_MARKERS.indexOf(String(v == null ? "" : v).trim().toLowerCase()) === -1; }
+function hasLiveActor(row) {
+  const na = String(row.next_actor == null ? "" : row.next_actor).trim().toLowerCase();
+  return na !== "" && na !== "none";
+}
+function hasResidual(row) { return hasLiveActor(row) || isPopulated(row.shane_needed_only_for); }
+function withinDays(updated_at, days, nowMs) {
+  if (!updated_at) return false;
+  const t = Date.parse(String(updated_at).replace(" ", "T") + "Z"); // relay_state ts are UTC
+  if (isNaN(t)) return false;
+  return (nowMs - t) <= days * 86400000;
+}
+// Non-terminal rows are always live; terminal rows are live only while they carry
+// residual ownership or were updated within the retention window.
+function boardEligible(row, nowMs) {
+  if (!isTerminal(row.status)) return true;
+  return hasResidual(row) || withinDays(row.updated_at, TERMINAL_RETENTION_DAYS, nowMs);
+}
+function clampLimit(raw, dflt, max) { const n = parseInt(raw, 10); if (!n || n < 1) return dflt; return n > max ? max : n; }
+
+// SQL mirrors of the above (filtering + pagination in the DB). NS = normalized status.
+const _NS = "REPLACE(LOWER(TRIM(status)),'_','-')";
+const _TERMINAL_PRED = "(" + _NS + " IN ('done','closed','complete','completed','verified') OR " + _NS + " LIKE 'verified-%')";
+const _RESIDUAL_PRED = "((LOWER(TRIM(COALESCE(next_actor,''))) NOT IN ('','none')) OR (LOWER(TRIM(COALESCE(shane_needed_only_for,''))) NOT IN ('','none','none.','-','—','n/a','nothing','nothing.')))";
+const SQL_BOARD_ELIGIBLE = "SELECT " + BOARD_LEAN_COLS.join(", ") + " FROM relay_state WHERE (NOT " + _TERMINAL_PRED + ") OR " + _RESIDUAL_PRED + " OR (updated_at >= datetime('now', ?)) ORDER BY updated_at DESC, id DESC LIMIT ?";
+const SQL_BUCKET_COUNTS = "SELECT CASE WHEN " + _NS + " = 'parked' THEN 'parked' WHEN " + _NS + " = 'blocked' THEN 'blocked' WHEN " + _NS + " IN ('done','closed','complete','completed','verified') OR " + _NS + " LIKE 'verified-%' THEN 'done' WHEN " + _NS + " IN ('active','open','in-progress','in progress','') THEN 'active' ELSE 'other' END AS bucket, COUNT(*) AS n FROM relay_state GROUP BY bucket";
+const SQL_ARCHIVE = "SELECT " + BOARD_LEAN_COLS.join(", ") + " FROM relay_state WHERE " + _TERMINAL_PRED + " ORDER BY updated_at DESC, id DESC LIMIT ? OFFSET ?";
+const SQL_ARCHIVE_COUNT = "SELECT COUNT(*) AS n FROM relay_state WHERE " + _TERMINAL_PRED;
+const SQL_BOARD_VIEW = "SELECT id, project, status, next_actor, updated_at, substr(COALESCE(shane_needed_only_for,''),1,400) AS shane_needed_only_for, substr(COALESCE(shane_read,''),1,600) AS shane_read, approval_required, proof_required, substr(COALESCE(next_safe_action,''),1,600) AS next_safe_action, substr(COALESCE(latest_builder_status,''),1,800) AS latest_builder_status, substr(COALESCE(handoff_note,''),1,600) AS handoff_note FROM relay_state WHERE (NOT " + _TERMINAL_PRED + ") OR " + _RESIDUAL_PRED + " OR (updated_at >= datetime('now', ?)) ORDER BY updated_at DESC, id DESC LIMIT ?";
+const _RETENTION_BIND = "-" + TERMINAL_RETENTION_DAYS + " days";

