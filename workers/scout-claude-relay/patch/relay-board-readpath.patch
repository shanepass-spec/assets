+async function handleBoardView(request, env) {
+  if (!env.COMPASS_DB) return new Response("COMPASS_DB binding missing", { status: 500 });
+  const url = new URL(request.url);
+  const limit = clampLimit(url.searchParams.get("limit"), BOARD_HARD_CAP, BOARD_HARD_CAP);
+  const countRes = await env.COMPASS_DB.prepare(SQL_BUCKET_COUNTS).all();
+  const counts = { active: 0, blocked: 0, parked: 0, done: 0, other: 0 };
+  for (const c of (countRes.results || [])) counts[c.bucket] = c.n;
+  const total = counts.active + counts.blocked + counts.parked + counts.done + counts.other;
+  const q = await env.COMPASS_DB.prepare(SQL_BOARD_VIEW).bind(_RETENTION_BIND, limit).all();
+  const rows = q.results || [];
+  const board = { active: [], blocked: [], parked: [], done: [], other: [] };
+  for (const r of rows) board[bucketFor(r.status)].push(r);
+  const canWrite = checkKey(request, env);
+  return new Response(boardViewHTML(board, total, canWrite, counts), { headers: { "Content-Type": "text/html;charset=utf-8", "Cache-Control": "no-store" } });
+}

@@ new: handleArchiveView() — HTML /archive (self-contained; reuses boardSectionHTML/boardCardHTML) @@
+async function handleArchiveView(request, env) {
+  if (!env.COMPASS_DB) return new Response("COMPASS_DB binding missing", { status: 500 });
+  const url = new URL(request.url);
+  const limit = clampLimit(url.searchParams.get("limit"), ARCHIVE_PAGE_DEFAULT, ARCHIVE_PAGE_MAX);
+  let page = parseInt(url.searchParams.get("page") || "1", 10); if (!page || page < 1) page = 1;
+  const offset = (page - 1) * limit;
+  const totalRow = await env.COMPASS_DB.prepare(SQL_ARCHIVE_COUNT).first();
+  const total = totalRow ? totalRow.n : 0;
+  const q = await env.COMPASS_DB.prepare(SQL_ARCHIVE).bind(limit, offset).all();
+  const rows = q.results || [];
+  const canWrite = checkKey(request, env);
+  const pages = Math.max(1, Math.ceil(total / limit));
+  let nav = "<div style='margin:14px'>";
+  if (page > 1) nav += "<a href='/archive?page=" + (page - 1) + "&limit=" + limit + "'>&larr; Newer</a> ";
+  nav += "<span>Page " + page + " of " + pages + " &middot; " + total + " terminal rows</span>";
+  if (offset + rows.length < total) nav += " <a href='/archive?page=" + (page + 1) + "&limit=" + limit + "'>Older &rarr;</a>";
+  nav += " &middot; <a href='/board'>&larr; Back to board</a></div>";
+  const section = boardSectionHTML("Archive", "🗄️", "done", rows, canWrite);
+  const html = "<!doctype html><meta name=viewport content='width=device-width,initial-scale=1'>"
+    + "<div class='top'><h1>Archive</h1><div class='sub'>All terminal history &middot; newest first</div></div>"
+    + nav + section + nav;
+  return new Response(html, { headers: { "Content-Type": "text/html;charset=utf-8", "Cache-Control": "no-store" } });
+}
+// If you want the archive page to share the board's CSS, factor the <style> block out of
+// boardViewHTML into a shared const and include it here. Functional without it.

