+async function handleRelayBoard(request, env) {
+  if (!env.COMPASS_DB) return jsonR({ ok: false, error: "COMPASS_DB binding not set" }, 500);
+  const url = new URL(request.url);
+  const wantId = (url.searchParams.get("id") || "").trim();
+  if (wantId) { // one whole row — the only full-detail escape hatch, bounded to 1 row
+    const one = await env.COMPASS_DB.prepare("SELECT * FROM relay_state WHERE id = ? LIMIT 1").bind(Number(wantId)).first();
+    if (!one) return jsonR({ ok: false, error: "No board row with id " + wantId }, 404);
+    return jsonR({ ok: true, version: VERSION, mode: "row", row: one });
+  }
+  const wantStatus = (url.searchParams.get("status") || "").trim().toLowerCase();
+  const limit = clampLimit(url.searchParams.get("limit"), BOARD_HARD_CAP, BOARD_HARD_CAP);
+  const countRes = await env.COMPASS_DB.prepare(SQL_BUCKET_COUNTS).all();
+  const counts = { active: 0, blocked: 0, parked: 0, done: 0, other: 0 };
+  for (const c of (countRes.results || [])) counts[c.bucket] = c.n;
+  const q = await env.COMPASS_DB.prepare(SQL_BOARD_ELIGIBLE).bind(_RETENTION_BIND, limit).all();
+  const rows = q.results || [];
+  const board = { active: [], blocked: [], parked: [], done: [], other: [] };
+  for (const r of rows) { const b = bucketFor(r.status); if (wantStatus && b !== wantStatus) continue; board[b].push(r); }
+  return jsonR({
+    ok: true, version: VERSION, mode: wantStatus ? ("bucket:" + wantStatus) : "index",
+    counts: counts, rows_returned: rows.length, limit: limit, hard_cap: BOARD_HARD_CAP,
+    fields_returned: BOARD_LEAN_COLS, retention_days: TERMINAL_RETENTION_DAYS,
+    note: "Live board: non-terminal rows plus terminal rows that still have a next_actor, a Shane gate, or an update within " + TERMINAL_RETENTION_DAYS + " days. All terminal history is at /relay/archive. One full row: ?id=N. One bucket: ?status=active.",
+    board: board
+  });
+}
+// NOTE: the old ?full=1 unbounded dump and BOARD_CORE/BOARD_CAP/BOARD_DONE_LIMIT/boardTrim/boardCore
+// (v1.17.0 helpers) are removed — full history now lives at the paginated /relay/archive.

@@ new: handleRelayArchive() — JSON /relay/archive (add near handleRelayBoard) @@
+async function handleRelayArchive(request, env) {
+  if (!env.COMPASS_DB) return jsonR({ ok: false, error: "COMPASS_DB binding not set" }, 500);
+  const url = new URL(request.url);
+  const limit = clampLimit(url.searchParams.get("limit"), ARCHIVE_PAGE_DEFAULT, ARCHIVE_PAGE_MAX);
+  let page = parseInt(url.searchParams.get("page") || "1", 10); if (!page || page < 1) page = 1;
+  const offset = (page - 1) * limit;
+  const totalRow = await env.COMPASS_DB.prepare(SQL_ARCHIVE_COUNT).first();
+  const total = totalRow ? totalRow.n : 0;
+  const q = await env.COMPASS_DB.prepare(SQL_ARCHIVE).bind(limit, offset).all();
+  const rows = q.results || [];
+  return jsonR({ ok: true, version: VERSION, mode: "archive", total: total, page: page, limit: limit,
+    pages: Math.max(1, Math.ceil(total / limit)), has_more: offset + rows.length < total,
+    fields_returned: BOARD_LEAN_COLS, rows: rows });
+}

